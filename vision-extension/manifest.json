{
  "manifest_version": 3,
  "name": "4Eyes",
  "version": "1.1",
  "description": "4Eyes adjusts every website to your eye prescription in real time. Less strain, clearer text, everywhere you browse.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://4eyes-production.up.railway.app/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
  {
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_end"
  },
  {
    "matches": ["https://4eyeslux.io/*", "https://khiryhill.github.io/*"],
    "js": ["token_bridge.js"],
    "run_at": "document_end"
  }
],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "externally_connectable": {
    "matches": [
      "https://khiryhill.github.io/*",
      "https://4eyeslux.io/*"
    ]
  }
}